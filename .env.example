# gRPC-сервер
GRPC_PORT=9090                                  # Порт gRPC-сервера

# Tarantool
TARANTOOL_HOST=tarantool                        # Хост Tarantool (внутри Docker Compose — имя сервиса)
TARANTOOL_PORT=3301                             # Порт Tarantool
TARANTOOL_LISTEN=0.0.0.0:3301                   # Адрес, на котором Tarantool принимает соединения
TARANTOOL_USER=test                             # Пользователь БД
TARANTOOL_PASSWORD=test                         # Пароль пользователя БД

# Подключение к Tarantool
TARANTOOL_CONNECT_TIMEOUT_MS=10000              # Таймаут подключения (мс)
TARANTOOL_CONNECTIONS=4                         # Количество соединений (event loop threads)

# Tarantool memtx-движок
MEMTX_MEMORY=2 * 1024 * 1024                    # Память, выделяемая memtx-движку (в байтах)

# KV-хранилище
KV_SPACE_NAME=kv                                # Имя space в Tarantool
KV_RANGE_BATCH_SIZE=5000                        # Размер батча при range-сканировании

# gRPC UI
GRPCUI_PORT=8080                                # Порт веб-интерфейса gRPC UI
